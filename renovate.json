{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "config:js-app", ":disableRateLimiting"],
  "packageRules": [
    // FIXME https://github.com/npm/cli/issues/9800
    // npm 12 fails to update the lockfile, which blocks Renovate.
    // Stay on npm 11 until the bug is fixed.
    {
      "matchDepNames": ["npm"],
      "matchManagers": ["npm"],
      "allowedVersions": "<12"
    },
    // FIXME https://github.com/renovatebot/renovate/discussions/46989
    {
      "matchDepTypes": ["devEngines.*"],
      "rangeStrategy": "auto"
    }
  ]
}
