---
import GithubIcon from "~icons/simple-icons/github";
import HuggingfaceIcon from "~icons/simple-icons/huggingface";
import LinkedinIcon from "~icons/simple-icons/linkedin";
import XIcon from "~icons/simple-icons/x";
import ExternalLinkIcon from "~icons/lucide/external-link";

import { socialLinks } from "../profile";

const ICONS: Record<string, typeof GithubIcon> = {
  GitHub: GithubIcon,
  "Hugging Face": HuggingfaceIcon,
  LinkedIn: LinkedinIcon,
  "X / Twitter": XIcon,
};

const links = socialLinks.map((link) => ({
  ...link,
  Icon: ICONS[link.label] ?? ExternalLinkIcon,
}));
---

<header class="w-full border-b border-neutral-200 dark:border-neutral-800">
  <nav class="max-w-2xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/">
      <img src="/favicon.svg" width="20" height="20" alt="Home" />
    </a>
    <ul class="flex gap-5 list-none m-0 p-0">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-label={link.label}
            title={link.label}
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-500 dark:hover:text-neutral-100 transition-colors"
          >
            <link.Icon class="w-4 h-4" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
